{
  "name": "revibe-launcher-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "main",
    "control-center"
  ],
  "scripts": {
    "dev:main": "npm run dev -w main",
    "dev:cc": "npm run dev -w control-center",
    "build:main": "npm run build -w main",
    "build:cc": "npm run build -w control-center",
    "build": "npm run build:main && npm run build:cc"
  }
}
